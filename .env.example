# Copy to .env and replace every value. Never commit .env.

# Warehouse (PostgreSQL)
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
WAREHOUSE_DB=stylesphere
WAREHOUSE_ADMIN_USER=stylesphere_admin
WAREHOUSE_ADMIN_PASSWORD=replace_me
WAREHOUSE_WRITER_USER=stylesphere_writer
WAREHOUSE_WRITER_PASSWORD=replace_me
WAREHOUSE_READER_USER=stylesphere_reader
WAREHOUSE_READER_PASSWORD=replace_me

# Twenty CRM
TWENTY_URL=http://localhost:3000
TWENTY_API_KEY=replace_me
