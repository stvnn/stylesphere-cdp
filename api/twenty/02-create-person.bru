meta {
  name: 02 create person
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/rest/people
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "name": { "firstName": "Test", "lastName": "Synthetic" },
    "emails": { "primaryEmail": "test.synthetic@example.com" }
  }
}

script:post-response {
  const data = res.body && res.body.data ? res.body.data : {};
  const rec = data.createPerson || data;
  if (rec && rec.id) {
    bru.setVar("personId", rec.id);
  }
}

tests {
  test("status 200 or 201", function () {
    expect([200, 201]).to.include(res.status);
  });
  test("id returned", function () {
    expect(bru.getVar("personId")).to.be.a("string");
  });
}
